# Backend API URL for Vite React frontend
# In production, set this to your deployed Node.js backend URL (e.g., https://your-app-name.onrender.com)
# In development, leave blank or set to http://localhost:5000
VITE_API_URL=
# Backend only: use a long random value outside local development.
JWT_SECRET=replace-with-a-long-random-secret
# Optional: grants admin access to this email address.
ADMIN_EMAIL=admin@example.com
# Production: use Render's Internal Database URL. When set, PostgreSQL is used
# instead of local SQLite and data survives service restarts.
DATABASE_URL=postgresql://user:password@host:5432/database
